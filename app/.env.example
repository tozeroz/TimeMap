# 地图 Key 模板：复制成 .env.local 后填入自己的 Key（.env.local 不会被提交）
#
# 腾讯位置服务（首选底图，与原版 app 同款服务）
#   控制台：https://lbs.qq.com/dev/console/key/manage
#   新建 Key 时选「Web端(JavaScript API)」，授权域名建议填 localhost
VITE_TENCENT_MAP_KEY=

# 高德开放平台（第二顺位兜底）
#   控制台：https://console.amap.com/dev/key/app
#   Key 类型选「Web端(JS API)」，安全密钥在同一页
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=
