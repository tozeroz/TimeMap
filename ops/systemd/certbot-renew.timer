# Let's Encrypt 证书续期定时器
#
# ⚠️ 为什么一天两次：本项目的证书是**纯 IP 证书**，有效期只有约 6 天
#    （LE 对 IP 证书强制 shortlived profile）。虽然有 deploy-hook 兜底，
#    但漏续一次就是**全站证书错误** ⇒ 用较高频率换取余量。
#    certbot 自己判断是否到期（剩余不足 1/3 才动手），所以频繁触发不会浪费
#    LE 的速率额度，也不会重复签发。
#
# ⚠️ 加 RandomizedDelaySec：LE 官方建议在整点/随机时间分散请求，避免集中冲击。
[Unit]
Description=Run certbot renew twice daily

[Timer]
OnCalendar=*-*-* 00,12:17:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
