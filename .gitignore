# 依赖与构建产物
node_modules/
dist/
build/
*.log
*.tsbuildinfo

# 服务器私钥 / 凭据 —— 绝不入库
*.pem
*.ppk
*.key
TimeMap.pem
.env
.env.*
!.env.example

# Capacitor / Android 构建产物
app/android/.gradle/
app/android/.kotlin/
app/android/app/build/
app/android/build/
app/android/local.properties
app/android/.idea/
app/android/captures/
app/android/app/src/main/assets/public/
app/android/app/src/main/assets/capacitor.config.json
*.apk
*.aab
*.keystore

# 勘察与对比的原始截图（体积大，且是外部 app 的截图，不进版本库）
.mumu-capture/
.playwright-mcp/
*.png
# Required web branding asset, copied by Vite from public/ into dist/.
!app/public/timemap-logo.png
# 例外：M0 冻结的原版行为基线截图必须入库（半分辨率，见 docs/test/original-baseline/）
!docs/test/original-baseline/**/*.png
# 地图复刻文档引用的用户参考图，随正式设计文档维护
!docs/public/product/assets/坐标地图页面参考.png
# 本轮地图布局验证截图（测试瓦片，含说明）
!docs/test/campus-map-20261105/*.png
# ⚠️ 例外：Android 的启动图与启动图标必须入库 —— 它们是**构建必需**的资源，不是截图。
#    踩过的坑：`*.png` 把 res/ 下的 splash.png / ic_launcher*.png 一起忽略了，
#    于是仓库里的 Android 工程**根本构建不起来**（AAPT2 报
#      "resource drawable/splash not found"），而这个坑在原作者机器上被
#    "那些文件本来就在本地、只是没进 git" 掩盖了很久。
!app/android/app/src/main/res/**/*.png

# 工具临时
tools/tmp/

# 系统
Thumbs.db
desktop.ini
.DS_Store

# 临时/工作目录（代理或脚本留下的 scratch；避免被 git add -A 无意带进仓库）
.tmp-*/
*.tmp-*
# 真机测试用的构建产物（不入库：8.5MB 二进制，且可由源码重建）
# ⚠️ 需要安装包时：pnpm build && npx cap sync android && gradlew assembleDebug，
#    或直接从服务器取：http://8.148.156.146/download/campus-demo-1.0.apk
campus-demo-*.apk
apk-download-qr.png
.pnpm-store/

# 本地文档、个人草稿和临时测试产物
/docs/local/

# Local PostgreSQL binaries, database files, credentials and development logs
/.local/

# VS Code 本地调试配置：每个人环境不同，不入库（.vscode/settings.json 仍跟踪）
.vscode/launch.json
